{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESPHome: lint",
      "type": "shell",
      "command": "esphome lint examples/roomba.yaml",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "ESPHome: config",
      "type": "shell",
      "command": "esphome config examples/roomba.yaml",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "ESPHome: compile (generate only)",
      "type": "shell",
      "command": "esphome compile examples/roomba.yaml --only-generate",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "ESPHome: compile",
      "type": "shell",
      "command": "esphome compile examples/roomba.yaml",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
